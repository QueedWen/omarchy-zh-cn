  function durationText(value) {
    return String(value || "")
      .replace(/(\d+)\s*h\s*(\d+)\s*m/, "$1 小时 $2 分")
      .replace(/(\d+)\s*h\b/, "$1 小时")
      .replace(/(\d+)\s*m\b/, "$1 分钟")
  }

  var match
  if ((match = original.match(/^Battery is down to (\d+)%$/))) return "电池电量已降至 " + match[1] + "%"
  if ((match = original.match(/^Process crashed: (.+)$/))) return "进程崩溃：" + match[1]
  if ((match = original.match(/^The session was left unlocked \((.+)\)\.$/))) return "会话处于未锁定状态（" + match[1] + "）。"
  if ((match = original.match(/^Screen recording directory does not exist: (.+)$/))) return "屏幕录制目录不存在：" + match[1]
  if ((match = original.match(/^Created screenshot directory: (.+)$/))) return "已创建截图目录：" + match[1]
  if ((match = original.match(/^Mirroring enabled \((.+)\)$/))) return "已启用镜像显示（" + match[1] + "）"
  if ((match = original.match(/^(.+) is now the default browser$/))) return match[1] + " 现已设为默认浏览器"
  if ((match = original.match(/^(.+) is now the default terminal$/))) return match[1] + " 现已设为默认终端"
  if ((match = original.match(/^(.+) is now the default editor$/))) return match[1] + " 现已设为默认编辑器"
  if ((match = original.match(/^Workspace layout set to (.+)$/))) {
    var layoutNames = {
      "scrolling": "滚动布局",
      "dwindle": "螺旋平铺",
      "master": "主从布局"
    }
    return "工作区布局已设为" + (layoutNames[match[1]] || match[1])
  }
  if ((match = original.match(/^Timezone is now set to (.+)$/))) return "时区现已设为 " + match[1]
  if ((match = original.match(/^No plugin to (.+)$/))) return "没有可执行“" + match[1] + "”操作的插件"
  if ((match = original.match(/^Reminder set for (\d+) minutes$/))) return "已设置 " + match[1] + " 分钟后的提醒"
  if ((match = original.match(/^You'll be reminded at (.+)$/))) return "将在 " + match[1] + " 提醒"
  if ((match = original.match(/^Your (\d+) minutes are up$/))) return match[1] + " 分钟时间已到"
  if ((match = original.match(/^(.+) in (\d+) minutes$/))) return match[1] + "（" + match[2] + " 分钟后）"
  if ((match = original.match(/^(.+) installed$/))) return match[1] + " 已安装"
  if ((match = original.match(/^Your new theme is (.+)$/))) return "新主题为 " + match[1]
  if ((match = original.match(/^Your new font is (.+)$/))) return "新字体为 " + match[1]
  if ((match = original.match(/^Sent to (.+)$/))) return "已发送到 " + match[1]
  if ((match = original.match(/^Could not send to (.+)$/))) return "无法发送到 " + match[1]
  if ((match = original.match(/^Transcoding video…$/))) return "正在转码视频…"
  if ((match = original.match(/^Transcoded to (.+)$/))) return "已转码为 " + match[1]
  if ((match = original.match(/^Click to run (\d+) pending migrations?\.$/))) return "点击运行 " + match[1] + " 个待处理的迁移。"
  if ((match = original.match(/^No saved width found for (.+) on workspace (.+)$/))) return "未找到 " + match[1] + " 在工作区 " + match[2] + " 保存的窗口宽度"
  if ((match = original.match(/^Saved width for (.+) on workspace (.+)$/))) return "已保存 " + match[1] + " 在工作区 " + match[2] + " 的窗口宽度"
  if ((match = original.match(/^Battery (\d+)%  ·  (.+) to full  ·  (.*)$/))) return "电池 " + match[1] + "%  ·  充满还需 " + durationText(match[2]) + "  ·  " + match[3]
  if ((match = original.match(/^Battery (\d+)%  ·  (.+) left  ·  (.*)$/))) return "电池 " + match[1] + "%  ·  剩余 " + durationText(match[2]) + "  ·  " + match[3]
  if ((match = original.match(/^Battery (\d+)%  ·  Holding at (.+)  ·  (.*)$/))) return "电池 " + match[1] + "%  ·  保持在 " + match[2] + "  ·  " + match[3]

  var localized = original
    .replace(/\s*·\s*Temp\s+/g, "  ·  温度 ")
    .replace(/\s*·\s*Wind\s+/g, "  ·  风速 ")
    .replace(/\bMonday\b/g, "星期一").replace(/\bTuesday\b/g, "星期二")
    .replace(/\bWednesday\b/g, "星期三").replace(/\bThursday\b/g, "星期四")
    .replace(/\bFriday\b/g, "星期五").replace(/\bSaturday\b/g, "星期六")
    .replace(/\bSunday\b/g, "星期日")
    .replace(/\bJanuary\b/g, "1月").replace(/\bFebruary\b/g, "2月")
    .replace(/\bMarch\b/g, "3月").replace(/\bApril\b/g, "4月")
    .replace(/\bMay\b/g, "5月").replace(/\bJune\b/g, "6月")
    .replace(/\bJuly\b/g, "7月").replace(/\bAugust\b/g, "8月")
    .replace(/\bSeptember\b/g, "9月").replace(/\bOctober\b/g, "10月")
    .replace(/\bNovember\b/g, "11月").replace(/\bDecember\b/g, "12月")
    .replace(/\bWeek (\d+)\b/g, "第 $1 周")
  return localized
}

if (typeof module !== "undefined") module.exports = { translate: translate }
`;

// 迁移脚本的运行时替换器：只把整条英文消息换成中文，其余内容原样保留。
// 生成失败、语法不过或读取异常时一律退回原文执行，绝不改变迁移结果。
const migrationRunnerTemplate = String.raw`#!/usr/bin/env node

const fs = require("fs");
const os = require("os");
const path = require("path");
const { spawnSync } = require("child_process");

const table = __TABLE__;
const source = process.argv[2];
const extraArgs = process.argv.slice(3);

function run(file) {
  const result = spawnSync("bash", ["-euo", "pipefail", file, ...extraArgs], { stdio: "inherit" });
  if (result.error) {
    console.error(result.error.message);
    return 1;
  }
  return result.status === null ? 1 : result.status;
}

if (!source) {
  console.error("用法：omarchy-migrate-zh-run <迁移脚本> [参数...]");
  process.exit(2);
}

let workDir = null;
let target = source;

try {
  const original = fs.readFileSync(source, "utf8");
  let content = original;
  for (const [from, to] of Object.entries(table)) {
    // 直接在脚本文本里找被引号包住的整条消息。这里不能用 JSON.stringify：
    // 它会把消息里的引号和反斜杠转义，反而匹配不到原文。split/join 同时避免
    // 替换串里的 $ 被当成替换模式解释。
    const search = '"' + from + '"';
    if (!content.includes(search)) continue;
    content = content.split(search).join('"' + to + '"');
  }
  if (content !== original) {
    const runtimeDir = process.env.XDG_RUNTIME_DIR || os.tmpdir();
    workDir = fs.mkdtempSync(path.join(runtimeDir, "omarchy-migrate-zh-"));
    const candidate = path.join(workDir, path.basename(source));
    fs.writeFileSync(candidate, content, { mode: 0o600 });
    // 替换必须过语法闸门，改坏了就退回原文。
    if (spawnSync("bash", ["-n", candidate]).status === 0) target = candidate;
    else console.error("迁移脚本替换后语法不通过，改为运行原文：" + source);
  }
} catch (error) {
  console.error("迁移脚本替换失败，改为运行原文：" + error.message);
  target = source;
}

const status = run(target);
if (workDir) fs.rmSync(workDir, { recursive: true, force: true });
process.exit(status);
`;

function migrationRunnerSource() {
  return migrationRunnerTemplate
    .split("__TABLE__")
    .join(JSON.stringify(migrationZh, null, 2).split("\n").map((line, index) => (index === 0 ? line : "  " + line)).join("\n"));
}

// 迁移通知的点击动作默认调用系统 omarchy-migrate。通知里的命令是数据，改不到源码，
// 所以在执行动作前把这一条换成中文迁移脚本，终端里的迁移输出才会一起汉化。
function migrationActionSource() {
  const migrateZhPath = path.join(updateLocalizerDir, "omarchy-migrate");
  return `  function localizedArgv(argv) {
    var launcher = "omarchy-launch-floating-terminal-with-presentation"
    if (!argv || argv.length !== 2 || argv[0] !== launcher) return argv
    if (argv[1] !== "omarchy-migrate") return argv
    return [launcher, ${JSON.stringify(migrateZhPath)}]
  }

`;
}

function stripJsonc(raw) {
  return String(raw || "").replace(/^\s*\/\/[^\n]*(\n|$)/gm, "").replace(/,(\s*[}\]])/g, "$1");
}

function translated(value) { return zh[value] || schemaZh[value] || value; }

function awkString(value) {
  return String(value).replace(/\\/g, "\\\\").replace(/"/g, '\\"');
}

function keybindingLocalizerSource() {
  const assignments = Object.entries(keybindingZh)
    .map(([from, to]) => `    zh["${awkString(from)}"] = "${awkString(to)}"`)
    .join("\n");

  return `localize_binding_records() {
  awk -F '\\t' '
  BEGIN {
    OFS = "\\t"
${assignments}
  }
  function translated_action(action, number) {
    if (action in zh) return zh[action]

    number = action
    if (number ~ /^Bar panel [0-9]+$/) {
      sub(/^Bar panel /, "", number); return "状态栏面板 " number
    }
    if (number ~ /^Move window silently to workspace [0-9]+$/) {
      sub(/^Move window silently to workspace /, "", number); return "将窗口静默移到工作区 " number
    }
    if (number ~ /^Move window to workspace [0-9]+$/) {
      sub(/^Move window to workspace /, "", number); return "将窗口移到工作区 " number
    }
    if (number ~ /^Switch to workspace [0-9]+$/) {
      sub(/^Switch to workspace /, "", number); return "切换到工作区 " number
    }
    if (number ~ /^Switch to group window [0-9]+$/) {
      sub(/^Switch to group window /, "", number); return "切换到分组窗口 " number
    }
    if (action == "Move window to group on bottom") return "将窗口移到下方分组"
    if (action == "Move window to group on left") return "将窗口移到左侧分组"
    if (action == "Move window to group on right") return "将窗口移到右侧分组"
    if (action == "Move window to group on top") return "将窗口移到上方分组"
    return action
  }
  {
    marker = " → "
    position = index($1, marker)
    if (position > 0) {
      combo = substr($1, 1, position + length(marker) - 1)
      action = substr($1, position + length(marker))
      $1 = combo translated_action(action)
    }
    print
  }'
}

`;
}

function syncPluginMenu() {
  if (!fs.existsSync(pluginMenuSource)) return;

  let content = fs.readFileSync(pluginMenuSource, "utf8");
  content = replaceRequired(
    content,
    String.raw`PLUGIN_ICON=$'\U000f0431'`,
    `PLUGIN_ICON=$'\\U000f0431'\nPLUGIN_NAMES='${JSON.stringify(pluginNameZh)}'`,
    "插件菜单结构已变化：名称映射"
  );
  content = replaceRequired(
    content,
    '--arg icon "$PLUGIN_ICON" \\',
    '--arg icon "$PLUGIN_ICON" --argjson names "$PLUGIN_NAMES" \\',
    "插件菜单结构已变化：名称参数"
  );
  content = replaceRequired(
    content,
    "+ .name +",
    "+ (\\$names[.name] // .name) +",
    "插件菜单结构已变化：名称列"
  );
  content = replaceRequired(
    content,
    "plugins=$(omarchy-plugin-list --json)",
    `case "\${1:-}" in
  enable) prompt="启用插件" ;;
  disable) prompt="禁用插件" ;;
  clone) prompt="克隆插件" ;;
  remove) prompt="移除插件" ;;
  *) prompt="\${1^} plugin" ;;
esac

plugins=$(omarchy-plugin-list --json)`,
    "插件菜单结构已变化：提示文案"
  );
  content = replaceRequired(
    content,
    'omarchy-menu-select "${1^} plugin" <<<"$rows"',
    'omarchy-menu-select "$prompt" <<<"$rows"',
    "插件菜单结构已变化：提示传参"
  );
  content = replaceRequired(
    content,
    'omarchy-notification-send "No plugin to ${1}"',
    'omarchy-notification-send "没有可执行“${prompt}”操作的插件"',
    "插件菜单结构已变化：空列表提示"
  );

  fs.mkdirSync(path.dirname(pluginMenuZh), { recursive: true });
  const temporary = `${pluginMenuZh}.new-${process.pid}`;
  fs.writeFileSync(temporary, content, { mode: 0o755 });
  fs.chmodSync(temporary, 0o755);
  fs.renameSync(temporary, pluginMenuZh);
}

function replaceRequired(content, from, to, label) {
  if (!content.includes(from)) throw new Error(label);
  // split/join instead of replace: replacement strings must not be able to
  // read `$&` or `$'` as patterns, which silently scrambles shell code.
  return content.split(from).join(to);
}

function syncKeybindings() {
  if (!fs.existsSync(keybindingsSource)) return;

  let content = fs.readFileSync(keybindingsSource, "utf8");
  content = replaceRequired(
    content,
    "output_keybindings() {\n  output_binding_records | cut -f1\n}",
    keybindingLocalizerSource() + "output_keybindings() {\n  output_binding_records | localize_binding_records | cut -f1\n}",
    "快捷键脚本结构已变化：输出函数"
  );
  content = replaceRequired(
    content,
    "records=$(output_binding_records)\n  selection=$(cut -f1 <<<\"$records\" |",
    "records=$(output_binding_records | localize_binding_records)\n  selection=$(cut -f1 <<<\"$records\" |",
    "快捷键脚本结构已变化：交互列表"
  );
  content = replaceRequired(
    content,
    "omarchy-menu-select 'Keybindings' -- --width 800 --height 500",
    "omarchy-menu-select '快捷键' -- --width 800 --height 500",
    "快捷键脚本结构已变化：面板标题"
  );

  fs.mkdirSync(path.dirname(keybindingsZh), { recursive: true });
  const temporary = `${keybindingsZh}.new-${process.pid}`;
  fs.writeFileSync(temporary, content, { mode: 0o755 });
  fs.chmodSync(temporary, 0o755);
  fs.renameSync(temporary, keybindingsZh);
}

function translateText(content) {
  let result = content;
  for (const [from, to] of Object.entries(zh)) {
    const source = JSON.stringify(from);
    const target = JSON.stringify(to);
    result = result.split(source).join(target);
  }
  return result;
}

function syncUpdateScripts() {
  fs.mkdirSync(updateLocalizerDir, { recursive: true });
  for (const [scriptName, replacements] of Object.entries(updateScriptReplacements)) {
    const source = path.join(updateSourceDir, scriptName);
    if (!fs.existsSync(source)) throw new Error(`找不到 Omarchy 更新脚本：${source}`);

    let content = fs.readFileSync(source, "utf8");
    for (const [from, to, label] of replacements) {
      if (!content.includes(from)) throw new Error(`更新脚本结构已变化：${scriptName} / ${label}`);
      content = content.split(from).join(to);
    }

    const bootstrap = 'export PATH="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd):$PATH"\n';
    if (!/^#![^\n]*\n/.test(content)) throw new Error(`更新脚本缺少 shebang：${scriptName}`);
    content = content.replace(/^#![^\n]*\n/, match => `${match}\n# 优先调用本目录下的中文子脚本。\n${bootstrap}\n`);

    const target = path.join(updateLocalizerDir, scriptName);
    const temporary = `${target}.new-${process.pid}`;
    fs.writeFileSync(temporary, content, { mode: 0o755 });
    fs.chmodSync(temporary, 0o755);
    fs.renameSync(temporary, target);
  }

  const runner = path.join(updateLocalizerDir, "omarchy-migrate-zh-run");
  const runnerTemporary = `${runner}.new-${process.pid}`;
  fs.writeFileSync(runnerTemporary, migrationRunnerSource(), { mode: 0o755 });
  fs.chmodSync(runnerTemporary, 0o755);
  fs.renameSync(runnerTemporary, runner);
}

function normalizedEmoji(value) {
  return String(value || "").replace(/\uFE0F/g, "");
}

function fallbackEmojiKeywords(value) {
  const words = ` ${String(value || "").toLowerCase().replace(/[^a-z0-9]+/g, " ").trim()} `;
  const matches = [];
  for (const [terms, translation] of emojiKeywordFallbacks) {
    if (terms.some(term => words.includes(` ${term} `))) matches.push(translation);
  }
  return matches;
}

function localizeEmojiKeywords(stage) {
  const emojiFile = path.join(stage, "emojis.json");
  if (!fs.existsSync(emojiFile)) throw new Error("表情插件缺少 emojis.json");

  const annotationCandidates = [
    path.join(home, ".local/share/fcitx5/rime/opencc/emoji.txt"),
    path.join(home, ".config/fcitx5/rime/opencc/emoji.txt"),
    "/usr/share/opencc/emoji.txt",
    "/usr/share/fcitx5/rime-data/opencc/emoji.txt"
  ];
  const annotationFile = annotationCandidates.find(candidate => fs.existsSync(candidate));
  if (!annotationFile) return;

  const items = JSON.parse(fs.readFileSync(emojiFile, "utf8"));
  const keywordsByEmoji = new Map(items.map(item => [normalizedEmoji(item.e), new Set()]));
  for (const line of fs.readFileSync(annotationFile, "utf8").split(/\r?\n/)) {
    const tab = line.indexOf("\t");
    if (tab < 1) continue;
    const keyword = line.slice(0, tab).trim();
    if (!/[\u3400-\u9fff]/.test(keyword)) continue;
    for (const token of line.slice(tab + 1).trim().split(/\s+/)) {
      const matches = keywordsByEmoji.get(normalizedEmoji(token));
      if (matches) matches.add(keyword);
    }
  }

  for (const item of items) {
    const additions = [...(keywordsByEmoji.get(normalizedEmoji(item.e)) || [])];
    if (additions.length === 0 && !/[\u3400-\u9fff]/.test(item.k)) {
      additions.push(...fallbackEmojiKeywords(item.k));
    }
    if (additions.length > 0) item.k = `${item.k} ${additions.join(" ")}`;
  }
  fs.writeFileSync(emojiFile, JSON.stringify(items) + "\n");
}

function walkFiles(dir, callback) {
  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
    const full = path.join(dir, entry.name);
    if (entry.isDirectory()) walkFiles(full, callback);
    else callback(full);
  }
}

function copyEntry(sourceDir, source, stage, target = source) {
  const src = path.join(sourceDir, source);
  const dst = path.join(stage, target);
  fs.mkdirSync(path.dirname(dst), { recursive: true });
  fs.cpSync(src, dst, { recursive: true, dereference: true });
}

function applyAgentsOverlay(stage, targetDir) {
  if (!agentsOverlayDir) throw new Error("找不到 Agents 用量扩展文件，请重新运行安装器");

  for (const directory of ["bin", "assets"]) {
    const source = path.join(agentsOverlayDir, directory);
    if (!fs.existsSync(source)) throw new Error(`Agents 用量扩展不完整：${source}`);
    fs.cpSync(source, path.join(stage, directory), { recursive: true, dereference: true });
  }
  for (const script of ["codex", "codex-collector", "grok-collector", "kimi-collector", "usage-update"]) {
    fs.chmodSync(path.join(stage, "bin", script), 0o755);
  }

  const mainFile = path.join(stage, "Main.qml");
  const commandSource = '    var command = ["omarchy-agent-usage-update"]';
  let main = fs.readFileSync(mainFile, "utf8");
  if (!main.includes(commandSource)) throw new Error("Agents 插件结构已变化：用量更新入口");
  main = main.replace(
    commandSource,
    `    var command = [${JSON.stringify(path.join(targetDir, "bin", "usage-update"))}]`
  );
  fs.writeFileSync(mainFile, main);

  const extraReadme = path.join(agentsOverlayDir, "README.md");
  if (fs.existsSync(extraReadme)) fs.copyFileSync(extraReadme, path.join(stage, "README.omarchy-zh-cn.md"));
}

function rebuildPlugin(catalogEntry) {
  const sourceId = catalogEntry.id;
  const suffix = sourceId.slice("omarchy.".length);
  const targetDir = path.join(pluginRoot, `${user}.${suffix}`);
  if (!targetDir.startsWith(pluginRoot + path.sep)) throw new Error(`不安全的插件路径：${targetDir}`);

  if (fs.existsSync(targetDir)) {
    let installedManifest = {};
    try {
      installedManifest = JSON.parse(fs.readFileSync(path.join(targetDir, "manifest.json"), "utf8"));
    } catch (_) {
      throw new Error(`现有插件缺少有效清单，拒绝覆盖：${targetDir}`);
    }
    const managed = installedManifest.omarchy?.zhCnManaged === true;
    const matchingClone = installedManifest.omarchy?.clonedFrom === sourceId;
    if (!managed && !(adoptExisting && matchingClone)) {
      throw new Error(`现有插件不是 omarchy-zh-cn 管理的克隆，拒绝覆盖：${targetDir}`);
    }
  }

  const stage = fs.mkdtempSync(path.join(pluginRoot, ".zh-sync."));
  const manifestPath = catalogEntry.manifestPath;
  const sourceDir = catalogEntry.sourceDir;
  const sourceManifest = JSON.parse(fs.readFileSync(manifestPath, "utf8"));

  try {
    if (path.basename(manifestPath) === "manifest.json") {
      fs.cpSync(sourceDir, stage, { recursive: true, dereference: true });
    } else {
      fs.copyFileSync(manifestPath, path.join(stage, "manifest.json"));
      const copies = [
        ...Object.values(sourceManifest.entryPoints || {}).map(source => ({ source, target: source })),
        ...((sourceManifest.omarchy || {}).clonePaths || [])
      ];
      for (const item of copies) copyEntry(sourceDir, item.source, stage, item.target);

      // Match `omarchy plugin clone`: when a dependency is relocated, update
      // relative references in the copied text files to point at its new path.
      for (const item of copies) {
        if (item.source === item.target) continue;
        walkFiles(stage, file => {
          if (!/\.(qml|js|json|jsonc|sh|md|txt)$/.test(file)) return;
          const before = fs.readFileSync(file, "utf8");
          const after = before.split(item.source).join(item.target);
          if (after !== before) fs.writeFileSync(file, after);
        });
      }
    }

    if (sourceId === "omarchy.speedtest" || sourceId === "omarchy.disk-speedtest") {
      if (!fs.existsSync(speedTestOverlaySource)) throw new Error("找不到测速公共界面组件");
      fs.copyFileSync(speedTestOverlaySource, path.join(stage, "SpeedTestOverlay.qml"));
    }

    const manifestFile = path.join(stage, "manifest.json");
    const manifest = JSON.parse(fs.readFileSync(manifestFile, "utf8"));
    manifest.id = `${user}.${suffix}`;
    manifest.name = translated(sourceManifest.name || sourceId);
    manifest.description = translated(manifest.description || "");
    if (manifest.barWidget) {
      manifest.barWidget.displayName = translated(sourceManifest.barWidget?.displayName || sourceManifest.name || sourceId);
      manifest.barWidget.description = translated(manifest.barWidget.description || "");
      manifest.barWidget.category = translated(manifest.barWidget.category || "");
      for (const field of manifest.barWidget.schema || []) {
        for (const key of ["label", "description", "noSelectionText", "placeholderText", "emptyText"]) {
          if (typeof field[key] === "string") field[key] = translated(field[key]);
        }
        for (const option of field.options || []) {
          if (typeof option.label === "string") option.label = translated(option.label);
          if (typeof option.description === "string") option.description = translated(option.description);
        }
      }
    }
    if (sourceId === "omarchy.agents") {
      manifest.description = "在 Omarchy 面板中显示 Claude Code、Codex、Fireworks、Grok 和 Kimi 的用量与限额";
      manifest.barWidget = manifest.barWidget || {};
      manifest.barWidget.defaults = manifest.barWidget.defaults || {};
      manifest.barWidget.defaults.providers = {
        ...(manifest.barWidget.defaults.providers || {}),
        grok: { enabled: true },
        kimi: { enabled: true }
      };
    }
    manifest.omarchy = { ...(manifest.omarchy || {}), clonedFrom: sourceId, zhCnManaged: true };
    delete manifest.omarchy.clonePaths;
    fs.writeFileSync(manifestFile, JSON.stringify(manifest, null, 2) + "\n");

    walkFiles(stage, file => {
      if (!/\.(qml|js|json|jsonc)$/.test(file)) return;
      const before = fs.readFileSync(file, "utf8");
      let after = translateText(before);
      if (sourceId === "omarchy.agents") {
        const agentsText = {
          "Panel.qml": [
            ['if (!(ms > 0)) return "now"', 'if (!(ms > 0)) return "现在"', "剩余时间"],
            ['return days + "d " + (hours % 24) + "h"', 'return days + " 天 " + (hours % 24) + " 小时"', "剩余天数"],
            ['return hours + "h " + (minutes % 60) + "m"', 'return hours + " 小时 " + (minutes % 60) + " 分钟"', "剩余小时"],
            ['return Math.max(1, minutes) + "m"', 'return Math.max(1, minutes) + " 分钟"', "剩余分钟"],
