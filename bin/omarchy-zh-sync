function syncMenu() {
  if (!fs.existsSync(menuDefault)) return;
  const defaults = JSON.parse(stripJsonc(fs.readFileSync(menuDefault, "utf8")));
  let existing = {};
  if (fs.existsSync(menuUser)) {
    try { existing = JSON.parse(stripJsonc(fs.readFileSync(menuUser, "utf8"))); } catch (_) {}
  }
  for (const [id, item] of Object.entries(defaults)) {
    const prior = existing[id] || {};
    const localized = menuZh[id] || {};
    const defaultLabel = item.label;
    const defaultTitle = item.title;
    if (prior.label && prior.label !== defaultLabel) item.label = prior.label;
    else if (defaultLabel) item.label = localized.label || translated(defaultLabel);
    if (prior.title && prior.title !== defaultTitle) item.title = prior.title;
    else if (defaultTitle) item.title = localized.title || translated(defaultTitle);
  }
  for (const [id, item] of Object.entries(existing)) {
    if (!(id in defaults)) defaults[id] = item;
  }
  if (defaults["learn.keybindings"]) defaults["learn.keybindings"].action = keybindingsZh;
  for (const id of ["setup.plugin.enable", "setup.plugin.disable", "setup.plugin.clone", "setup.plugin.remove"]) {
    if (defaults[id]) defaults[id].action = `${pluginMenuZh} ${id.split(".").pop()}`;
  }
  if (defaults["update.omarchy"]) {
    defaults["update.omarchy"].action = `omarchy-launch-floating-terminal-with-presentation ${updateZh}`;
  }
  for (const [id, script] of [["update.firmware", "omarchy-update-firmware"], ["update.time", "omarchy-update-time"]]) {
    if (defaults[id]) {
      defaults[id].action = `omarchy-launch-floating-terminal-with-presentation ${path.join(updateLocalizerDir, script)}`;
    }
  }
  const header = "// Omarchy 4 简体中文菜单：动作来自当前系统版本，文字由本地汉化保留。\n";
  fs.mkdirSync(path.dirname(menuUser), { recursive: true });
  fs.writeFileSync(menuUser, header + JSON.stringify(defaults, null, 2) + "\n");
}

function syncShellSettings() {
  const shellPath = path.join(home, ".config/omarchy/shell.json");
  if (!fs.existsSync(shellPath)) return;

  const shell = JSON.parse(fs.readFileSync(shellPath, "utf8"));
  for (const section of ["left", "center", "right"]) {
    for (const widget of shell.bar?.layout?.[section] || []) {
      if (widget.id === `${user}.weather` || widget.id === "omarchy.weather") widget.unit = "metric";
    }
  }

  const temporary = `${shellPath}.zh-new-${process.pid}`;
  fs.writeFileSync(temporary, JSON.stringify(shell, null, 2) + "\n");
  fs.renameSync(temporary, shellPath);
}

fs.mkdirSync(pluginRoot, { recursive: true });
fs.mkdirSync(stateDir, { recursive: true });
syncUpdateScripts();
const catalog = JSON.parse(execFileSync("omarchy-plugin-catalog", { encoding: "utf8" }));
const byId = new Map(catalog.filter(item => item.firstParty).map(item => [item.id, item]));
for (const id of pluginIds) {
  const entry = byId.get(id);
  if (!entry) throw new Error(`找不到系统插件：${id}`);
  rebuildPlugin(entry);
}
syncMenu();
syncKeybindings();
syncPluginMenu();
syncShellSettings();
fs.writeFileSync(path.join(stateDir, "last-sync"), new Date().toISOString() + "\n");

// Quickshell can retain imported JavaScript modules across a plugin rescan.
// Restart the shell so notification display translations are always current.
if (!noRestart) {
  try { execFileSync("omarchy", ["restart", "shell"], { stdio: quiet ? "ignore" : "inherit" }); } catch (_) {
    try { execFileSync("omarchy-shell", ["shell", "rescanPlugins"], { stdio: quiet ? "ignore" : "inherit" }); } catch (_) {}
  }
}
if (!quiet) console.log(`已同步 ${pluginIds.length} 个中文插件、Omarchy 菜单、快捷键面板和更新流程。`);
