#!/usr/bin/env node

// Rebuild the user's Omarchy 4 Chinese plugin clones from the current packaged
// sources, then apply display-string translations. System files are read-only.

const fs = require("fs");
const os = require("os");
const path = require("path");
const { execFileSync } = require("child_process");

const quiet = process.argv.includes("--quiet");
const noRestart = process.argv.includes("--no-restart");
const adoptExisting = process.argv.includes("--adopt-existing");
const home = os.homedir();
const user = process.env.USER || path.basename(home);
const pluginRoot = path.join(home, ".config/omarchy/plugins");
const menuDefault = "/usr/share/omarchy/default/omarchy/omarchy-menu.jsonc";
const menuUser = path.join(home, ".config/omarchy/extensions/omarchy-menu.jsonc");
const stateDir = path.join(home, ".local/state/omarchy-zh");
const keybindingsSource = "/usr/share/omarchy/bin/omarchy-menu-keybindings";
const keybindingsZh = path.join(home, ".local/bin/omarchy-menu-keybindings-zh");

const pluginIds = [
  "omarchy.audio", "omarchy.bluetooth", "omarchy.clock", "omarchy.monitor",
  "omarchy.network", "omarchy.power", "omarchy.weather", "omarchy.agents",
  "omarchy.menu", "omarchy.notifications",
  "omarchy.tray", "omarchy.indicators", "omarchy.system-update", "omarchy.lock", "omarchy.polkit",
  "omarchy.clipboard", "omarchy.emojis", "omarchy.image-picker",
  "omarchy.reminders", "omarchy.speedtest", "omarchy.disk-speedtest",
  "omarchy.wifiqr"
];

const supportedArgs = new Set(["--quiet", "--no-restart", "--adopt-existing", "--help"]);
for (const arg of process.argv.slice(2)) {
  if (!supportedArgs.has(arg)) throw new Error(`未知参数：${arg}`);
}
if (process.argv.includes("--help")) {
  console.log(`用法：omarchy-zh-sync [--quiet] [--no-restart] [--adopt-existing]

从当前安装的 Omarchy 4 源文件重建简体中文用户插件。
  --quiet           仅在失败时输出
  --no-restart      同步后不重启 Omarchy Shell
  --adopt-existing  接管同名且来源匹配的现有插件克隆`);
  process.exit(0);
}

